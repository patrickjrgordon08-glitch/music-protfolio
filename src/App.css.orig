.studio-shell {
  min-height: 100vh;
  max-width: 1680px;
  margin: auto;
  padding: 0 38px;
  background:
    radial-gradient(ellipse at 78% -20%, #49594322, transparent 38%), #171a18;
}
.topbar {
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
}
.brand {
  display: flex;
  align-items: center;
  gap: 9px;
  text-decoration: none;
  color: var(--paper);
  font-size: 13px;
  font-weight: 800;
}
.brand-mark {
  width: 27px;
  height: 27px;
  display: grid;
  place-items: center;
  color: #192018;
  background: var(--lime);
  border-radius: 7px 7px 7px 2px;
}
.brand-sub {
  color: #879089;
  font-weight: 500;
}
.save-state {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-left: 40px;
  color: #b4bbb4;
  font-size: 11px;
}
.save-state i,
.arrangement-footer i,
.statusbar > span:first-child i,
.monitor > i {
  width: 6px;
  height: 6px;
  display: inline-block;
  border-radius: 50%;
  background: var(--lime);
  box-shadow: 0 0 9px #d0ef9270;
}
.save-state em {
  color: #4d554f;
  font-style: normal;
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}
.icon-button,
.transport button,
.tempo button,
.track-buttons button {
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  cursor: pointer;
}
.icon-button {
  width: 32px;
  height: 32px;
  color: #a6afa8;
  border-radius: 5px;
}
.icon-button:hover,
.transport button:hover {
  color: var(--paper);
  background: #292e2b;
}
.export-button {
  height: 32px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 11px;
  color: #1a2018;
  border: 0;
  border-radius: 4px;
  background: var(--lime);
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
}
.export-button:hover {
  background: #def5ad;
}
.avatar {
  width: 28px;
  height: 28px;
  border: 1px solid #444b45;
  border-radius: 50%;
  background: #343a35;
  font-size: 11px;
  font-weight: 700;
}
.session-heading {
  min-height: 106px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #79827b;
  font: 9px var(--mono);
}
.eyebrow i {
  width: 16px;
  height: 1px;
  background: #5f6b5f;
}
.session-heading h1 {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 7px 0 0;
  color: #eff0e9;
  font: 500 22px var(--mono);
}
.session-heading h1 svg {
  color: #77817a;
}
.session-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #9ba29b;
  font: 10px var(--mono);
}
.session-meta > span:first-child {
  display: flex;
  align-items: center;
  gap: 6px;
}
.session-meta > i {
  width: 1px;
  height: 13px;
  background: #3b423c;
}
.avatars {
  display: flex;
}
.avatars b {
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  margin-left: -3px;
  border: 2px solid #171a18;
  border-radius: 50%;
  background: #d0957f;
  color: #271b19;
  font: 9px var(--mono);
}
.avatars b:nth-child(2) {
  background: #a1bb83;
}
.avatars b:nth-child(3) {
  background: #343a35;
  color: #cbd0c8;
  font-weight: 400;
}
.transport {
  position: relative;
  height: 66px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  border: 1px solid #343a35;
  border-radius: 5px;
  background: linear-gradient(100deg, #222623, #202421 60%, #242825);
  box-shadow: 0 6px 20px #0002;
}
.transport-buttons,
.transport-right {
  display: flex;
  align-items: center;
  gap: 7px;
}
.transport button {
  width: 31px;
  height: 31px;
  color: #a0a8a0;
  border-radius: 4px;
}
.transport button.record {
  color: #ee8978;
}
.transport button.active {
  color: var(--lime);
}
.transport .play {
  width: 37px;
  height: 37px;
  margin: 0 3px;
  padding-left: 2px;
  border: 1px solid var(--lime);
  border-radius: 50%;
  background: var(--lime);
  color: #1a2018;
}
.transport .play:hover {
  background: #def5ad;
}
.position {
  position: absolute;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  font-family: var(--mono);
}
.position strong {
  color: #e8ece2;
  font-size: 17px;
  line-height: 1.3;
  font-weight: 500;
}
.position small {
  color: #747d75;
  font-size: 8px;
}
.tempo {
  height: 36px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 7px;
  border: 1px solid #373e38;
  border-radius: 4px;
  background: #1c201d;
  font: 13px var(--mono);
}
.tempo button {
  width: 17px;
  height: 24px;
  color: #90988f;
  font-size: 16px;
}
.tempo b {
  font-weight: 500;
}
.tempo small {
  color: #788078;
  font-size: 8px;
}
.meter {
  height: 34px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 9px;
  color: #aab1aa;
  border: 1px solid #373e38;
  border-radius: 4px;
  background: none;
  font: 11px var(--mono);
  cursor: pointer;
}
.workspace-tools {
  height: 54px;
  display: flex;
  align-items: end;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
}
.tabs {
  height: 100%;
  display: flex;
  align-items: end;
  gap: 20px;
}
.tabs button {
  position: relative;
  height: 36px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 2px;
  color: #858d86;
  border: 0;
  background: none;
  font-size: 11px;
  cursor: pointer;
}
.tabs button.selected {
  color: #dce3d9;
}
.tabs button.selected:after {
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 2px;
  content: "";
  background: var(--lime);
}
.snap {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 6px;
  padding-top: 6px;
  color: #7a837c;
  font: 9px var(--mono);
}
.snap:first-letter {
  color: var(--lime);
}
.snap b {
  color: #c2c9c1;
  font-weight: 400;
}
.snap .icon-button {
  margin-left: 5px;
}
.work-area {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 282px;
  min-height: 560px;
}
.arrangement {
  min-width: 0;
  border-right: 1px solid var(--line);
}
.track-head,
.ruler {
  height: 50px;
  display: grid;
  grid-template-columns: 218px minmax(0, 1fr);
  border-bottom: 1px solid var(--line);
}
.track-head {
  align-items: center;
  padding-right: 14px;
}
.track-head > span {
  display: flex;
  justify-content: space-between;
  padding-right: 15px;
  color: #859087;
  font: 9px var(--mono);
}
.track-head > span b {
  color: #515a53;
  font-weight: 400;
}
.add-track {
  width: max-content;
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 8px;
  color: #c3ccc2;
  border: 1px solid #414a41;
  border-radius: 3px;
  background: #252a26;
  font-size: 10px;
  cursor: pointer;
}
.add-track:hover {
  color: var(--lime);
  border-color: #778a65;
}
.timeline-scroll {
  overflow-x: auto;
  scrollbar-color: #4a554b #202421;
  scrollbar-width: thin;
}
.ruler {
  min-width: 780px;
  grid-template-columns: 218px minmax(0, 1fr);
  height: 35px;
  background: #1c201d;
}
.ruler-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 13px;
  color: #687169;
  font: 8px var(--mono);
}
.ruler-label b {
  color: #8a938b;
  font-weight: 400;
}
.bar-numbers {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
}
.bar-numbers span {
  display: flex;
  align-items: center;
  padding-left: 7px;
  border-left: 1px solid #363d37;
  color: #89918a;
  font: 9px var(--mono);
}
.bar-numbers span.current {
  color: var(--lime);
}
.arrangement-body {
  min-width: 780px;
  display: grid;
  grid-template-columns: 218px minmax(0, 1fr);
}
.track-list {
  border-right: 1px solid #384039;
}
.track-info {
  height: 82px;
  display: flex;
  align-items: center;
  padding: 0 9px 0 3px;
  border-bottom: 1px solid #303732;
  background: linear-gradient(90deg, #1d211e, #1b1f1c);
}
.track-info.muted,
.channel.muted {
  opacity: 0.52;
}
.track-color {
  width: 3px;
  height: 36px;
  flex: 0 0 auto;
  margin-right: 9px;
  border-radius: 3px;
}
.track-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.track-copy strong {
  overflow: hidden;
  color: #d8dcd5;
  font-size: 10px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.track-copy small {
  overflow: hidden;
  color: #7e877f;
  font: 8px var(--mono);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.track-buttons {
  display: flex;
  gap: 3px;
  margin-left: 7px;
}
.track-buttons button {
  width: 19px;
  height: 19px;
  color: #778079;
  border: 1px solid #39413a;
  border-radius: 3px;
  font: 8px var(--mono);
}
.track-buttons button.on {
  color: #171a18;
  border-color: #ef8c79;
  background: #ef8c79;
}
.track-buttons button.solo-on {
  color: #171a18;
  border-color: var(--lime);
  background: var(--lime);
}
.clip-grid {
  position: relative;
  min-width: 0;
  background: #1b1f1c;
  background-image: linear-gradient(
    90deg,
    transparent calc(100% - 1px),
    #343b35 calc(100% - 1px)
  );
  background-size: 12.5% 100%;
}
.grid-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(
    90deg,
    transparent 0,
    transparent calc(3.125% - 1px),
    #ffffff06 calc(3.125% - 1px),
    #ffffff06 3.125%
  );
}
.clip-lane {
  position: relative;
  height: 82px;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #303732;
}
.clip {
  position: absolute;
  height: 57px;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--clip), white 20%);
  border-radius: 3px;
  background: color-mix(in srgb, var(--clip), #222721 74%);
  box-shadow: inset 0 2px 0 color-mix(in srgb, var(--clip), transparent 48%);
}
.wave {
  position: absolute;
  inset: 8px 7px 15px;
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 2px;
  opacity: 0.7;
}
.wave i {
  width: 2px;
  min-height: 2px;
  border-radius: 3px;
  background: var(--clip);
}
.clip-title {
  position: absolute;
  right: 6px;
  bottom: 3px;
  left: 6px;
  overflow: hidden;
  color: color-mix(in srgb, var(--clip), white 33%);
  font: 8px var(--mono);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.playhead {
  position: absolute;
  z-index: 2;
  top: 0;
  bottom: 0;
  width: 1px;
  background: var(--lime);
  box-shadow: 0 0 8px #d0ef9280;
  pointer-events: none;
  transition: left 0.12s linear;
}
.arrangement-footer {
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 13px;
  color: #778179;
  font: 8px var(--mono);
}
.arrangement-footer span:first-child {
  display: flex;
  align-items: center;
  gap: 6px;
}
.arrangement-footer i,
.statusbar > span:first-child i {
  width: 5px;
  height: 5px;
}
.arrangement-footer b {
  padding: 0 5px;
  color: #515a53;
  font-weight: 400;
}
.mixer {
  min-width: 0;
  padding: 20px 16px 15px;
  background: linear-gradient(180deg, #1c201d, #1a1e1b);
}
.mixer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.mixer-heading small {
  color: #7e8b7f;
  font: 8px var(--mono);
}
.mixer-heading h2 {
  margin: 3px 0 0;
  color: #e5e8e1;
  font-size: 13px;
  font-weight: 600;
}
.master {
  height: 54px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 8px;
  border: 1px solid #3a443a;
  border-radius: 4px;
  background: #242a25;
}
.master-icon {
  width: 27px;
  height: 27px;
  display: grid;
  place-items: center;
  border-radius: 4px;
  background: #333c30;
  color: var(--lime);
}
.master-name,
.monitor > span {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.master-name b,
.monitor b {
  overflow: hidden;
  color: #dbe0d8;
  font-size: 9px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.master-name small,
.monitor small {
  color: #7e897f;
  font: 7px var(--mono);
}
.master-meter {
  height: 26px;
  display: flex;
  gap: 2px;
  align-items: end;
  padding: 2px;
  background: #171b18;
}
.master-meter i {
  width: 4px;
  height: 82%;
  background: linear-gradient(
    to top,
    #83c87c 0 65%,
    #d0ef92 65% 88%,
    #ed9977 88%
  );
}
.master-meter i + i {
  height: 68%;
}
.master-db {
  color: #c5cec2;
  font: 9px var(--mono);
  white-space: nowrap;
}
.master-db small {
  color: #7e897f;
  font-size: 7px;
}
.channel-list {
  margin-top: 14px;
}
.channel {
  height: 63px;
  display: grid;
  grid-template-columns: 3px minmax(62px, 1fr) minmax(75px, 1.12fr) 7px;
  align-items: center;
  gap: 8px;
  border-bottom: 1px solid #303732;
}
.channel-color {
  width: 3px;
  height: 28px;
  border-radius: 3px;
}
.channel-name {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.channel-name b {
  overflow: hidden;
  color: #d0d6ce;
  font-size: 8px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.channel-name small {
  color: #7e887f;
  font: 7px var(--mono);
}
.fader {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.fader input {
  width: 100%;
  height: 3px;
  margin: 3px 0 0;
  appearance: none;
  border-radius: 3px;
  background: linear-gradient(
    to right,
    var(--channel) var(--level),
    #414840 var(--level)
  );
  cursor: pointer;
}
.fader input::-webkit-slider-thumb {
  width: 9px;
  height: 9px;
  appearance: none;
  border: 1px solid #c3d5a7;
  border-radius: 50%;
  background: #edf5df;
}
.fader input::-moz-range-thumb {
  width: 8px;
  height: 8px;
  border: 1px solid #c3d5a7;
  border-radius: 50%;
  background: #edf5df;
}
.fader small {
  color: #aab2a9;
  font: 8px var(--mono);
}
.meter {
  width: 6px;
  height: 38px;
  display: flex;
  align-items: end;
  padding: 1px;
  background: #161a17;
}
.meter b {
  width: 100%;
  min-height: 2px;
  background: linear-gradient(
    to top,
    #76b884 0 74%,
    #c9de83 74% 91%,
    #dd9678 91%
  );
  opacity: 0.78;
}
.mixer-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 1px 15px;
  color: #818a82;
  font: 7px var(--mono);
}
.mixer-foot span:first-child {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #9eaa9c;
}
.mixer-foot b {
  color: #c4cbbf;
  font-weight: 400;
}
.monitor {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 9px;
  border: 1px solid #333a34;
  border-radius: 4px;
  background: #212622;
  color: #b5c3ae;
}
.monitor > span {
  gap: 4px;
}
.monitor > i {
  width: 5px;
  height: 5px;
}
.statusbar {
  min-height: 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #303632;
  color: #737d75;
  font: 8px var(--mono);
}
.statusbar > span {
  display: flex;
  align-items: center;
  gap: 7px;
}
.statusbar > span:first-child {
  color: #8c978c;
}
.statusbar b {
  color: #b7c0b5;
  font-weight: 400;
}
.statusbar > span > i:not(:first-child) {
  width: 1px;
  height: 11px;
  margin: 0 4px;
  background: #3c433d;
}
@keyframes pulse {
  50% {
    opacity: 0.45;
  }
}
@media (max-width: 1050px) {
  .studio-shell {
    padding: 0 22px;
  }
  .work-area {
    grid-template-columns: minmax(0, 1fr) 245px;
  }
  .track-head,
  .ruler,
  .arrangement-body {
    grid-template-columns: 190px minmax(0, 1fr);
  }
  .ruler,
  .arrangement-body,
  .track-head {
    min-width: 780px;
  }
}
@media (max-width: 760px) {
  .studio-shell {
    padding: 0 14px;
  }
  .topbar {
    height: 56px;
  }
  .save-state,
  .top-actions > .icon-button {
    display: none;
  }
  .top-actions {
    gap: 6px;
  }
  .export-button {
    width: 33px;
    justify-content: center;
    padding: 0;
    font-size: 0;
  }
  .export-button svg {
    width: 16px;
    height: 16px;
  }
  .session-heading {
    min-height: 94px;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    gap: 9px;
  }
  .session-heading h1 {
    font-size: 19px;
  }
  .session-meta {
    gap: 8px;
    font-size: 9px;
  }
  .transport {
    height: 61px;
    padding: 0 7px;
  }
  .transport-buttons,
  .transport-right {
    gap: 2px;
  }
  .transport button {
    width: 27px;
    height: 29px;
  }
  .transport .play {
    width: 34px;
    height: 34px;
  }
  .position {
    top: 9px;
  }
  .position strong {
    font-size: 15px;
  }
  .position small {
    font-size: 7px;
  }
  .tempo {
    height: 32px;
    gap: 5px;
    padding: 0 4px;
  }
  .tempo button {
    width: 14px;
  }
  .meter {
    height: 32px;
    gap: 4px;
    padding: 0 5px;
    font-size: 9px;
  }
  .transport-right > .icon-button {
    display: none;
  }
  .workspace-tools {
    height: 47px;
  }
  .tabs {
    gap: 15px;
  }
  .tabs button {
    font-size: 10px;
  }
  .snap {
    gap: 4px;
  }
  .work-area {
    display: flex;
    flex-direction: column;
  }
  .arrangement {
    border-right: 0;
  }
  .track-head {
    height: 44px;
    min-width: 0;
  }
  .ruler {
    height: 31px;
  }
  .track-info,
  .clip-lane {
    height: 72px;
  }
  .clip {
    height: 50px;
  }
  .mixer {
    padding: 17px 10px 13px;
    border-top: 1px solid var(--line);
  }
  .mixer-heading {
    margin-bottom: 12px;
  }
  .channel {
    grid-template-columns: 3px minmax(90px, 1fr) minmax(120px, 1.4fr) 7px;
  }
  .statusbar {
    gap: 8px;
    font-size: 7px;
  }
  .statusbar > span {
    gap: 5px;
  }
  .statusbar > span:first-child {
    font-size: 0;
  }
  .statusbar > span:first-child:after {
    content: "NORTHLINE";
    font-size: 7px;
  }
  .statusbar > span > i:not(:first-child) {
    margin: 0 1px;
  }
}
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
